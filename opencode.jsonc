{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "think-observation": {
      "description": "Observe and record facts.",
      "mode": "subagent",
      "prompt": "What facts are observable in the current context?",
      "permission": {
        "list": "allow",
        "grep": "allow",
        "task": {
          "help-command": "allow",
          "local-search": "allow",
          "ask-exp": "allow",
          "structured-data-query": "allow",
          "think-*": "deny",
        },
        "lsp": "allow",
        "bash": "deny",
        "edit": "deny",
      },
    },
    "think-reasoning": {
      "description": "Analyze cause and effect.",
      "mode": "subagent",
      "prompt": "What logical inferences can be drawn from the available information?",
      "permission": {
        "list": "allow",
        "grep": "allow",
        "task": {
          "help-command": "allow",
          "local-search": "allow",
          "ask-exp": "allow",
          "structured-data-query": "allow",
          "think-*": "deny",
        },
        "lsp": "allow",
        "bash": "deny",
        "edit": "deny",
      },
    },
    "think-action": {
      "description": "Plan concrete steps.",
      "mode": "subagent",
      "prompt": "What concrete actions should be taken based on the current understanding?",
      "permission": {
        "list": "allow",
        "grep": "allow",
        "task": {
          "help-command": "allow",
          "local-search": "allow",
          "ask-exp": "allow",
          "structured-data-query": "allow",
          "think-*": "deny",
        },
        "lsp": "allow",
        "bash": "deny",
        "edit": "deny",
      },
    },
    "think-questioning": {
      "description": "Challenge assumptions.",
      "mode": "subagent",
      "prompt": "What assumptions might be flawed, or what questions remain unanswered?",
      "permission": {
        "list": "allow",
        "grep": "allow",
        "task": {
          "help-command": "allow",
          "local-search": "allow",
          "ask-exp": "allow",
          "structured-data-query": "allow",
          "think-*": "deny",
        },
        "lsp": "allow",
        "bash": "deny",
        "edit": "deny",
      },
    },
    "think-inspiration": {
      "description": "Generate novel ideas.",
      "mode": "subagent",
      "prompt": "What novel ideas, analogies, or creative possibilities could be relevant here?",
      "permission": {
        "list": "allow",
        "grep": "allow",
        "task": {
          "help-command": "allow",
          "local-search": "allow",
          "ask-exp": "allow",
          "structured-data-query": "allow",
          "think-*": "deny",
        },
        "lsp": "allow",
        "bash": "deny",
        "edit": "deny",
      },
    },
    "think-reflection": {
      "description": "Evaluate and summarize.",
      "mode": "subagent",
      "prompt": "What has been learned from this process, and how can it be improved?",
      "permission": {
        "list": "allow",
        "grep": "allow",
        "task": {
          "help-command": "allow",
          "local-search": "allow",
          "ask-exp": "allow",
          "structured-data-query": "allow",
          "think-*": "deny",
        },
        "lsp": "allow",
        "bash": "deny",
        "edit": "deny",
      },
    },
    "help-command": {
      "description": "Subagent for exploring command usages via help mechanisms in a non-blocking way.",
      "mode": "subagent",
      "prompt": "Use non-blocking methods like 'command --help' to explore and summarize command options, assisting in thinking and planning without execution.",
      "permission": {
        "bash": {
          "* -h": "allow",
          "* --help": "allow",
          "* help": "allow",
          "help *": "allow",
          "*": "deny",
        },
      },
    },
    "local-search": {
      "description": "Sub-agent for local code search and indexing",
      "mode": "subagent",
      "prompt": "You are a local search sub-agent. Actively use 'rg' (ripgrep) for efficient indexing and searching of local code. Use regex patterns to find functions, variables, imports, or specific code patterns in the codebase. Prioritize fast, accurate searches to assist with code navigation and analysis.",
      "permission": {
        "bash": {
          "pwd": "allow",
          "ls *": "allow",
          "rg *": "allow",
          "*": "deny",
        },
        "lsp": "allow",
      },
    },
    "ask-exp": {
      "description": "Error memory sub-agent that searches project share directory for documented experiences and solutions related to errors",
      "mode": "subagent",
      "prompt": "You are an error memory sub-agent. When given an error description, search the project's share/ directory for relevant .exp.md files containing past experiences and solutions. Use grep to find matching keywords, read the full experience files, and return actionable insights. Focus on finding similar error patterns and proven solutions from documented experiences.",
      "permission": {
        "read": {
          "share/**/*.exp.md": "allow",
          "tmp/**/*.md": "allow",
          "*": "deny",
        },
        "list": {
          "share/**/*.exp.md": "allow",
          "tmp/**/*.md": "allow",
          "*": "deny",
        },
        "grep": {
          "share/**/*.exp.md": "allow",
          "tmp/**/*.md": "allow",
          "*": "deny",
        },
        "task": "allow",
      },
    },
    "structured-data-query": {
      "description": "Responsible for querying structured data (JSON/YAML) using curl jq yq pipelines.",
      "mode": "subagent",
      "prompt": "You are a sub-agent for querying structured data using curl jq yq pipelines.\n\nDefine terms:\n- Structured data: JSON or YAML data with defined schemas (e.g., objects, arrays, key-value pairs).\n- Query: Extract, filter, or convert structured data using jq/yq syntax.",
      "permission": {
        "bash": {
          "echo *": "allow",
          "cat *": "allow",
          "curl *": "allow",
          "grep *": "allow",
          "jq *": "allow",
          "yq *": "allow",
          "*": "deny",
        },
      },
    },
  },
}
