{
  "name": "@cognotate/core",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build index.ts --target=bun --outdir ./dist --metafile=./dist/meta.json --metafile-md=./dist/meta.md",
    "test": "bun test",
    "db:gen": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:push:force": "bunx --bun prisma db push --force-reset",
    "db:pull": "bunx --bun prisma db pull",
    "db:seed": "bunx --bun prisma db seed",
    "db:studio": "bunx --bun prisma studio",
    "db:migrate:dev": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:migrate:reset": "bunx --bun prisma migrate reset"
  },
  "devDependencies": {
    "@types/bun": "catalog:types",
    "@types/lodash": "catalog:types",
    "prisma": "^7.3.0"
  },
  "peerDependencies": {
    "typescript": "catalog:types"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@ai-sdk/deepseek": "^2.0.15",
    "@ai-sdk/google": "^3.0.20",
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/xai": "^3.0.46",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@prisma/adapter-libsql": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "ai": "^6.0.64",
    "jsonc-parser": "^3.3.1",
    "lodash": "catalog:",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "zod": "catalog:"
  }
}
